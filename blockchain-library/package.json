{
  "name": "blockchain-library",
  "version": "1.0.0",
  "description": "Blockchain Book Lending System",
  "scripts": {
    "compile": "node_modules/.bin/truffle compile",
    "migrate": "truffle migrate --network development",
    "migrate:reset": "node_modules/.bin/truffle migrate --reset --network development",
    "test": "node_modules/.bin/truffle test",
    "start": "cd frontend && python3 -m http.server 8080"
  },
  "devDependencies": {
    "truffle": "^5.11.5"
  },
  "dependencies": {
    "web3": "^1.10.0"
  }
}
